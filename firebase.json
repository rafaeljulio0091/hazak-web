{
  "hosting": {
    "public": "public/build",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "hazak-web",
          "region": "southamerica-east1"
        }
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
